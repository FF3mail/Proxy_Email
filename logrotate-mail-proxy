# =============================================================================
# Конфигурация logrotate для проекта mail-proxy
# =============================================================================
#
# Обслуживает все лог-файлы в /var/log/mail-proxy/:
#   - mail-proxy-daemon.log  (Python-демон, пишет через logging)
#   - web_admin.log          (PHP веб-панель, пишет через writeLog())
#
# Ротация: ежедневно, хранить 30 дней, сжимать gzip.
# =============================================================================

/var/log/mail-proxy/*.log {

    # -----------------------------------------------------------------
    # Периодичность ротации
    # -----------------------------------------------------------------

    # Ротация выполняется ежедневно.
    # При интенсивной нагрузке (500 референтов) лог демона может
    # достигать нескольких сотен МБ в сутки — daily предпочтительнее weekly.
    daily

    # -----------------------------------------------------------------
    # Хранение архивов
    # -----------------------------------------------------------------

    # Хранить 30 ротированных файлов (30 дней истории).
    rotate 30

    # -----------------------------------------------------------------
    # Сжатие
    # -----------------------------------------------------------------

    # Сжимать ротированные файлы через gzip.
    compress

    # Не сжимать самый свежий ротированный файл — он может потребоваться
    # для диагностики сразу после ротации, до следующего цикла.
    # Сжатие применится при следующей ротации (файл станет вторым по счёту).
    delaycompress

    # -----------------------------------------------------------------
    # Поведение при отсутствии или пустом файле
    # -----------------------------------------------------------------

    # Не выдавать ошибку если файл не найден (демон мог не запускаться).
    missingok

    # Не выполнять ротацию если файл пустой — экономит место и
    # исключает создание пустых архивов за дни без активности.
    notifempty

    # -----------------------------------------------------------------
    # Создание нового лог-файла после ротации
    # -----------------------------------------------------------------

    # Создать новый пустой лог-файл сразу после ротации.
    # Без этой директивы демон и веб-панель продолжат писать в
    # переименованный (ротированный) файл до перезапуска.
    create 0640 vmail vmail

    # -----------------------------------------------------------------
    # Предотвращение потери данных при ротации
    # -----------------------------------------------------------------

    # Сначала создать новый файл, затем переименовать старый.
    # Это критично для демона: между переименованием и сигналом
    # может пройти время — без copytruncate или create+signal
    # записи будут теряться.
    # copytruncate НЕ используется — он создаёт окно гонки при копировании.
    # Вместо этого используем postrotate-сигнал (см. ниже).

    # -----------------------------------------------------------------
    # Расширение имён архивов
    # -----------------------------------------------------------------

    # Добавлять дату к имени ротированного файла вместо числового суффикса.
    # Пример: mail-proxy-daemon.log-20250115.gz
    # Упрощает поиск логов за конкретную дату при диагностике.
    dateext

    # Формат даты в имени архива: YYYYMMDD.
    dateformat -%Y%m%d

    # -----------------------------------------------------------------
    # Права на директорию
    # -----------------------------------------------------------------

    # Не менять права на директорию /var/log/mail-proxy при ротации.
    # Права управляются через mail-proxy-setup.sh и tmpfiles.d.
    su vmail vmail

    # -----------------------------------------------------------------
    # Уведомление активных процессов о ротации
    # -----------------------------------------------------------------

    # Действия выполняются ПОСЛЕ ротации всех файлов в блоке.
    # sharedscripts гарантирует однократный запуск postrotate
    # даже если ротируется несколько файлов одновременно.
    sharedscripts

    postrotate

        # --- Уведомление Python-демона ---
        # Посылаем SIGHUP главному процессу демона.
        # Демон должен обработать SIGHUP и переоткрыть лог-файл.
        # Если PID-файл не существует или демон не запущен — игнорируем ошибку.
        #
        # Примечание: в текущей версии демона обработчик SIGHUP не реализован
        # (реализованы только SIGTERM и SIGINT).
        # До добавления обработчика SIGHUP используем USR1 через systemd.
        #
        if systemctl is-active --quiet mail-proxy; then
            systemctl kill --kill-who=main --signal=SIGUSR1 mail-proxy 2>/dev/null || true
        fi

        # --- Уведомление PHP-FPM ---
        # PHP-панель использует file_put_contents с FILE_APPEND — дескриптор
        # не кэшируется между запросами, поэтому PHP-FPM перезапускать не нужно.
        # Новый файл создаётся директивой create и будет использован
        # при следующем обращении к writeLog().

    endscript

}